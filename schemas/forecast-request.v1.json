{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yusufcemaydin/yardstick-predict/schemas/forecast-request.v1.json",
  "title": "yardstick-predict forecast request, version 1",
  "type": "object",
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "predictor": {
      "type": "string",
      "description": "Which predictor to use. Default: your default predictor, set with `yardstick-predict default NAME`."
    },
    "distribution": {
      "type": "boolean",
      "default": false,
      "description": "Also return each forecast's full curve."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "models"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Your id for the task. Unique in the request."
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context": {
            "type": "string",
            "description": "The conversation so far, if there is one."
          },
          "effort": {
            "type": "string",
            "description": "The thinking level. Default: the model's most common one."
          },
          "agent": {
            "type": "string",
            "description": "claude-code or codex. Default: the model's most common one."
          },
          "origin": {
            "type": "string",
            "enum": [
              "program",
              "person"
            ],
            "default": "program"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skills the agent will use, by name. A predictor with the skills feature embeds their descriptions."
          },
          "extra": {
            "type": "object",
            "description": "Values for features you added yourself. Each one reaches your feature as info.extra."
          },
          "project": {
            "type": "string",
            "description": "The project's folder name. Features you add can use it."
          }
        }
      }
    }
  }
}
